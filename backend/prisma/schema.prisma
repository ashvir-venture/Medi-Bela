generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  PHARMACIST
}

// DEACTIVATED: paused by the user (signs in again to return).
// SUSPENDED: banned by an admin (login refused, never lifted by login).
// DELETED: de-identified; the row stays so prescriptions and history keep a patient.
enum AccountStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
  DELETED
}

enum FamilyEventKind {
  CREATED
  JOINED
  LEFT
  REMOVED
  CAREGIVER_CHANGED
}

enum Language {
  EN
  BN
}

// CAREGIVER (was OWNER until Round 6) runs the family: invites members and
// may act for any member who doesn't hide from family.
enum FamilyRole {
  CAREGIVER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// PENDING (uploaded) -> REJECTED (with feedback; the user may re-upload)
//                   -> AWAITING_CONFIRMATION (pharmacist prepared it)
//                   -> ACTIVE (confirmed; reminders run) -> ENDED (course over)
enum PrescriptionStatus {
  PENDING
  REJECTED
  AWAITING_CONFIRMATION
  ACTIVE
  ENDED
}

enum RoutineSource {
  PRESCRIPTION
  SELF_ADDED
}

enum DoseStatus {
  PENDING
  TAKEN
  MISSED
  SKIPPED
}

enum HealthReminderStatus {
  PENDING
  COMPLETED
  DISMISSED
  // A test reminder not done by the end of its third day.
  MISSED
}

enum HealthRecordType {
  BLOOD_PRESSURE
  BLOOD_SUGAR
  WEIGHT
  TEMPERATURE
  HEART_RATE
  OTHER
  // Round 15
  INSULIN
  SLEEP
  WATER
  PEAK_FLOW
}

// Round 15: when a sugar reading was taken.
enum SugarContext {
  FASTING
  AFTER_FOOD
  BEFORE_BED
  RANDOM
}

enum BpArm {
  LEFT
  RIGHT
}

// Insulin injection sites (the body faces the viewer in the app).
enum InjectionSite {
  LEFT_THIGH
  RIGHT_THIGH
  LEFT_ABDOMEN
  RIGHT_ABDOMEN
  LEFT_ARM
  RIGHT_ARM
}

enum InjectionGiver {
  SELF
  FAMILY
  NURSE
}

// A reading against the user's own saved limits at the time it was saved.
// NULL = no limit saved for that kind (no chip, no alert).
enum RangeState {
  IN_RANGE
  BELOW
  ABOVE
}

enum SugarUnit {
  MMOL
  MGDL
}

// Round 15: things logged on the condition pages (one row per event).
// Round 16: dated health-record entries with a reminder the day before.
enum AppointmentKind {
  // Doctor visit: reminder the day before at 19:00.
  VISIT
  // Pregnancy check-up (ANC), numbered; same reminder as a visit.
  ANC
  // Chemo session (cancer page); same reminder as a visit.
  CHEMO
}

enum OwnTestStatus {
  UPCOMING
  DONE
}

enum CareLogKind {
  SYMPTOMS
  KICKS
  RELIEVER
  TD_DOSE
}

enum SuggestionStatus {
  DRAFT
  PUBLISHED
}

enum NoticeStatus {
  DRAFT
  // Drafted by a pharmacist, waiting for an admin.
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum NoticeAudience {
  ALL
  USER
  ADMIN
}

enum NotificationType {
  MEDICINE_REMINDER
  MISSED_DOSE_FAMILY_ALERT
  PRESCRIPTION_UPDATE
  NOTICE
  SYSTEM
}

enum PushStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum AssistantConversationStatus {
  OPEN
  CLOSED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model User {
  id                       String        @id @default(uuid()) @db.Uuid
  // NULL only on DELETED accounts (the number is free for a new sign-up).
  phone                    String?       @unique
  name                     String
  address                  String?
  passwordHash             String
  role                     Role          @default(USER)
  accountStatus            AccountStatus @default(ACTIVE)
  languagePreference       Language      @default(EN)
  notificationsEnabled     Boolean       @default(true)
  // Off: no medicine reminders, backstop pushes or missed-dose family alerts.
  medicineRemindersEnabled Boolean       @default(true)
  // Round 13: when "Start your medicine box" was done (null = not started).
  medicineBoxStartedAt     DateTime?
  // Round 14: the user's own reminder timings; NULL = the .env default
  // (common/config/reminder-timing.ts). Ring gap, Later delay, number of
  // rings and when the family is told (also the On time / Late line).
  reminderRepeatMinutes    Int?
  reminderLaterMinutes     Int?
  reminderRings            Int?
  familyAlertMinutes       Int?
  // Round 14: easy mode for elders (the user or their caregiver switches it).
  easyMode                 Boolean       @default(false)
  // Off: notices are not pushed (still listed in the app).
  noticesEnabled           Boolean       @default(true)
  // The privacy flag, stored inverted: false = "Hide from family" switched
  // on, which hides this user from every family member, the owner included.
  profileVisibleToFamily   Boolean       @default(true)
  dateOfBirth              DateTime?     @db.Date
  genderId                 Int?
  // Address: each level must belong to the one above it, enforced by the
  // composite foreign keys below (a district of another division is rejected).
  divisionId               Int?
  districtId               Int?
  upazilaId                Int?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  // Set when the password is RESET (forgot-password): access tokens issued
  // before this moment are rejected, so a stolen session cannot outlive a reset.
  passwordChangedAt        DateTime?
  deactivatedAt            DateTime?
  deletedAt                DateTime?
  suspendedAt              DateTime?
  // Set on delete from dateOfBirth (which is erased), so age bands stay right.
  birthYear                Int?
  // When the user ticked "I agree to the Privacy & terms" at sign-up (Round 11).
  termsAcceptedAt          DateTime?
  // Round 15: optional height (BMI on weight readings) and when the
  // "My care" step after sign-up was done or skipped (null = show it).
  heightCm                 Int?
  careStepDoneAt           DateTime?

  familyMemberships        FamilyMember[]
  sentInvitations          FamilyInvitation[]      @relation("InvitationSender")
  prescriptions            Prescription[]          @relation("PrescriptionOwner")
  reviewedPrescriptions    Prescription[]          @relation("PrescriptionReviewer")
  verifiedMedicines        PrescriptionMedicine[]  @relation("MedicineVerifier")
  medicineRoutines         MedicineRoutine[]
  medicineDoses            MedicineDose[]
  givenDoses               MedicineDose[]          @relation("DoseGiver")
  healthReminders          HealthReminder[]
  healthRecords            HealthRecord[]
  createdSuggestionRules   HealthSuggestionRule[]  @relation("RuleCreator")
  healthSuggestions        HealthSuggestion[]      @relation("SuggestionSubject")
  publishedSuggestions     HealthSuggestion[]      @relation("SuggestionPublisher")
  createdNotices           Notice[]                @relation("NoticeCreator")
  notifications            Notification[]
  deviceTokens             DeviceToken[]
  assistantConversations   AssistantConversation[]
  passwordResetCode        PasswordResetCode?
  gender                   Gender?                 @relation(fields: [genderId], references: [id], onDelete: Restrict)
  division                 Division?               @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  district                 District?               @relation(fields: [districtId, divisionId], references: [id, divisionId], onDelete: Restrict)
  upazila                  Upazila?                @relation(fields: [upazilaId, districtId], references: [id, districtId], onDelete: Restrict)
  createdDoctors           Doctor[]                @relation("DoctorCreator")
  createdMedicines         Medicine[]              @relation("MedicineCreator")
  editedRoutines           MedicineRoutine[]       @relation("RoutineEditor")
  approvedNotices          Notice[]                @relation("NoticeApprover")
  auditActions             AuditLog[]              @relation("AuditActor")
  auditSubjectOf           AuditLog[]              @relation("AuditSubject")
  uploadedPrescriptions    Prescription[]          @relation("PrescriptionUploader")
  confirmedPrescriptions   Prescription[]          @relation("PrescriptionConfirmer")
  createdRoutines          MedicineRoutine[]       @relation("RoutineCreator")
  personalReminders        PersonalReminder[]      @relation("PersonalReminderOwner")
  createdPersonalReminders PersonalReminder[]      @relation("PersonalReminderCreator")
  medicineStocks           MedicineStock[]         @relation("MedicineStockOwner")
  updatedMedicineStocks    MedicineStock[]         @relation("MedicineStockUpdater")
  familyEventsAbout        FamilyEvent[]           @relation("FamilyEventSubject")
  familyEventsBy           FamilyEvent[]           @relation("FamilyEventActor")
  conditions               UserCondition[]
  healthLimits             HealthLimits?           @relation("HealthLimitsOwner")
  careSettings             CareSetting[]           @relation("CareSettingOwner")
  dayTicks                 DayTick[]
  careLogs                 CareLog[]               @relation("CareLogOwner")
  doctorQuestions          DoctorQuestion[]
  myDoctors                MyDoctor[]
  appointments             Appointment[]           @relation("AppointmentOwner")
  ownTests                 OwnTest[]               @relation("OwnTestOwner")
  recordPrescriptions      RecordPrescription[]    @relation("RecordPrescriptionOwner")
  recordPhotos             RecordPhoto[]

  @@index([role])
  @@map("users")
}

model Family {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     FamilyMember[]
  invitations FamilyInvitation[]
  events      FamilyEvent[]

  @@map("families")
}

// The family's activity feed. Names are not copied: the feed shows each
// user's current name ("Deleted user" once deleted).
model FamilyEvent {
  id            String          @id @default(uuid()) @db.Uuid
  familyId      String          @db.Uuid
  kind          FamilyEventKind
  subjectUserId String?         @db.Uuid
  actorUserId   String?         @db.Uuid
  createdAt     DateTime        @default(now())

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  subject User?  @relation("FamilyEventSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  actor   User?  @relation("FamilyEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt, id])
  @@map("family_events")
}

model FamilyMember {
  id       String     @id @default(uuid()) @db.Uuid
  familyId String     @db.Uuid
  userId   String     @db.Uuid
  role     FamilyRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  // A user belongs to at most ONE family. Enforced here (not just in
  // service code) so concurrent create/accept requests cannot race past it.
  @@unique([userId])
  @@map("family_members")
}

model FamilyInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  familyId     String           @db.Uuid
  invitedPhone String
  invitedById  String           @db.Uuid
  status       InvitationStatus @default(PENDING)
  respondedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([invitedPhone])
  @@index([familyId, status])
  @@map("family_invitations")
}

model Prescription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  // NULL once the patient deleted their account (the photo is erased).
  imageUrl               String?
  status                 PrescriptionStatus @default(PENDING)
  reviewedById           String?            @db.Uuid
  reviewedAt             DateTime?
  rejectionReason        String?
  processingNote         String?
  // Client-generated id sent by the mobile app on upload (see
  // PrescriptionApi.uploadDraft's `clientId`). Used purely as an
  // idempotency key so a retried offline sync can't create a duplicate
  // prescription server-side; never exposed as the canonical id.
  clientUploadId         String?            @unique
  // Filled in by the pharmacist.
  doctorId               String?            @db.Uuid
  visitDate              DateTime?          @db.Date
  diagnosis              String?
  nextVisitDate          DateTime?          @db.Date
  // A re-upload after a rejection points at the rejected prescription.
  previousPrescriptionId String?            @db.Uuid
  // Medicine lines belong to a revision. A pharmacist edit after activation
  // is a new pendingRevision; the current one keeps running until the user
  // confirms (or edits) it.
  currentRevision        Int                @default(1)
  pendingRevision        Int?
  // Who uploaded / confirmed it: the patient, or their caregiver acting for them.
  uploadedById           String?            @db.Uuid
  confirmedById          String?            @db.Uuid
  confirmedAt            DateTime?
  // The patient (or caregiver) asked for changes instead of confirming: the
  // prescription went back to PENDING with this note for the pharmacist.
  // Cleared when the pharmacist sends it again; editRequestedAt stays.
  editRequestNote        String?
  editRequestedAt        DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user          User                   @relation("PrescriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    User?                  @relation("PrescriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploadedBy    User?                  @relation("PrescriptionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  confirmedBy   User?                  @relation("PrescriptionConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  doctor        Doctor?                @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  previous      Prescription?          @relation("Reupload", fields: [previousPrescriptionId], references: [id], onDelete: SetNull)
  reuploads     Prescription[]         @relation("Reupload")
  medicines     PrescriptionMedicine[]
  tests         PrescriptionTest[]
  testReminders HealthReminder[]

  @@index([userId, status])
  // Admin queues: filter by status, newest first, cursor-paginated.
  @@index([status, createdAt])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionMedicine {
  id             String    @id @default(uuid()) @db.Uuid
  prescriptionId String    @db.Uuid
  medicineName   String
  dosage         String
  // Human-readable frequency as written by the admin/pharmacist (e.g.
  // "twice daily"). Kept alongside the structured fields below because
  // it's what gets displayed to the user; the structured fields are what
  // routine generation actually consumes.
  frequency      String
  duration       String
  instructions   String?
  // --- Structured fields consumed by deterministic routine generation ---
  // Number of doses per day. Required (and validated) before a
  // prescription can be completed — never inferred from `frequency`.
  timesPerDay    Int?
  // Explicit clock times ("HH:mm", 24h) for each dose, stored as a JSON
  // array string, e.g. ["08:00","20:00"]. Length must equal `timesPerDay`.
  scheduleTimes  String?
  // Whole-number treatment length in days, entered explicitly by the
  // admin — never parsed/guessed from the free-text `duration` field.
  durationDays   Int?
  // Optional explicit start date for the routine; if omitted, routine
  // generation defaults it to the date the prescription is completed
  // (an administrative default, not a clinical one).
  startDate      DateTime?
  // --- Structured line (Round 4) ---
  revision       Int       @default(1)
  medicineId     String?   @db.Uuid
  // Strength lives on the line, not on Medicine (e.g. "500 mg").
  strength       String?
  // Amount per dose, e.g. "1 tablet", "2 tsp".
  doseAmount     String?
  mealTimingId   Int?
  // Tablet, Syrup... (medicine_forms). Prefilled from the catalog medicine.
  formId         Int?
  // Every N days (1 = every day). N > 1 starts the day after confirmation
  // unless a start date is given.
  intervalDays   Int       @default(1)
  // No end date: doses keep being generated (rolling) until stopped.
  continuous     Boolean   @default(false)
  verified       Boolean   @default(false)
  verifiedById   String?   @db.Uuid
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  prescription Prescription      @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  verifiedBy   User?             @relation("MedicineVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  medicine     Medicine?         @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  mealTiming   MealTiming?       @relation(fields: [mealTimingId], references: [id], onDelete: Restrict)
  form         MedicineForm?     @relation(fields: [formId], references: [id], onDelete: Restrict)
  routines     MedicineRoutine[]

  @@index([prescriptionId, revision])
  @@index([medicineId])
  @@map("prescription_medicines")
}

model MedicineRoutine {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @db.Uuid
  prescriptionMedicineId String?       @db.Uuid
  medicineName           String
  dosage                 String
  frequency              String
  startDate              DateTime
  endDate                DateTime?
  active                 Boolean       @default(true)
  source                 RoutineSource @default(PRESCRIPTION)
  strength               String?
  doseAmount             String?
  mealTimingId           Int?
  formId                 Int?
  // Doses on every Nth day counted from startDate (1 = every day).
  intervalDays           Int           @default(1)
  // "HH:mm" JSON array, e.g. ["08:00","20:00"]. Set => the rolling job keeps
  // doses generated ahead (up to endDate, or with no end when endDate is
  // null). Null on routines created before Round 4: all their doses exist.
  scheduleTimes          String?
  // Doses exist up to (excluding) this instant; the rolling job continues here.
  generatedUntil         DateTime?
  // Set when someone other than the pharmacist changed it ("edited by you").
  lastEditedById         String?       @db.Uuid
  lastEditedAt           DateTime?
  // Who added it: the patient or their caregiver (null = from a prescription).
  createdById            String?       @db.Uuid
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptionMedicine PrescriptionMedicine? @relation(fields: [prescriptionMedicineId], references: [id], onDelete: SetNull)
  mealTiming           MealTiming?           @relation(fields: [mealTimingId], references: [id], onDelete: Restrict)
  form                 MedicineForm?         @relation(fields: [formId], references: [id], onDelete: Restrict)
  lastEditedBy         User?                 @relation("RoutineEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  createdBy            User?                 @relation("RoutineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  doses                MedicineDose[]
  healthSuggestions    HealthSuggestion[]
  stock                MedicineStock?

  @@index([userId, active])
  // Pharmacist routine panel: newest first, keyset pages.
  @@index([createdAt, id])
  @@map("medicine_routines")
}

model MedicineDose {
  id                     String     @id @default(uuid()) @db.Uuid
  routineId              String     @db.Uuid
  userId                 String     @db.Uuid
  scheduledAt            DateTime
  status                 DoseStatus @default(PENDING)
  takenAt                DateTime?
  // Set exactly once, atomically, when the missed-dose pipeline has handled
  // this dose (alert created, or deliberately skipped). Guarantees one
  // family alert per missed dose even with overlapping job runs.
  familyAlertProcessedAt DateTime?
  // Round 14: who marked it taken when it wasn't the patient (the caregiver,
  // "I gave it"); NULL = the patient. Set null if that account is removed.
  takenById              String?    @db.Uuid
  // Round 14: taken after the family-alert time (the patient's own or the
  // .env default at that moment) = Late. NULL while not taken.
  takenLate              Boolean?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  routine MedicineRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenBy User?           @relation("DoseGiver", fields: [takenById], references: [id], onDelete: SetNull)

  @@index([userId, scheduledAt])
  @@index([routineId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("medicine_doses")
}

/// Health-rule reminders, and test reminders (testId set): a prescription's
/// test rings on its date (or 3 days after confirmation) and the next two
/// days until Done; the caregiver is told on the third day, and it is MISSED
/// after that.
/// A reminder the user (or their caregiver) sets up themself (Round 13):
/// "Time for your {name}" with the description, at its times every day or
/// every N days. The app schedules it on the phone (banner, Done / Later);
/// Later on one a caregiver set up tells the caregiver.
model PersonalReminder {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  name          String
  description   String?
  // "HH:mm" JSON array, like medicine_routines.scheduleTimes.
  scheduleTimes String
  intervalDays  Int       @default(1)
  startDate     DateTime
  endDate       DateTime?
  active        Boolean   @default(true)
  // Who set it up: the user or their caregiver.
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User  @relation("PersonalReminderOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PersonalReminderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@map("personal_reminders")
}

/// Medicine box (Round 13): how many units of a routine's medicine were in
/// the box at [countedAt]. What is left = quantity - units of the doses taken
/// since then (units per dose = the number in the dose amount, else 1).
model MedicineStock {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  routineId   String   @unique @db.Uuid
  quantity    Float
  countedAt   DateTime
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation("MedicineStockOwner", fields: [userId], references: [id], onDelete: Cascade)
  routine   MedicineRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  updatedBy User?           @relation("MedicineStockUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("medicine_stocks")
}

model HealthReminder {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  sourceRuleId       String?              @db.Uuid
  // Test reminders: title = test name, description = the pharmacist's note.
  prescriptionId     String?              @db.Uuid
  testId             String?              @db.Uuid
  mealTimingId       Int?
  caregiverAlertedAt DateTime?
  title              String
  description        String?
  scheduledAt        DateTime
  status             HealthReminderStatus @default(PENDING)
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRule   HealthSuggestionRule? @relation(fields: [sourceRuleId], references: [id], onDelete: SetNull)
  prescription Prescription?         @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  test         DiagnosticTest?       @relation(fields: [testId], references: [id], onDelete: SetNull)
  mealTiming   MealTiming?           @relation(fields: [mealTimingId], references: [id], onDelete: Restrict)

  @@index([userId, scheduledAt])
  @@index([userId, status])
  // Test-reminder job: pending test reminders by time.
  @@index([status, scheduledAt])
  @@map("health_reminders")
}

model HealthRecord {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       HealthRecordType
  value      String
  unit       String?
  notes      String?
  recordedAt DateTime         @default(now())
  // Client-generated id of the offline draft; idempotency key so a retried
  // sync (response lost, app killed) can never create the record twice.
  clientId   String?          @db.Uuid
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Round 15: structured values next to the display `value`. numericValue:
  // sugar in mmol/L, weight kg, temperature °F, insulin units, sleep hours,
  // water glasses, peak flow L/min. BP: the average of 1-2 measurements.
  numericValue    Float?
  systolic        Int?
  diastolic       Int?
  pulse           Int?
  bpArm           BpArm?
  measurements    Int?
  sugarContext    SugarContext?
  injectionSite   InjectionSite?
  injectionGiver  InjectionGiver?
  // The insulin dose this injection was logged for (marks it taken too).
  doseId          String?         @db.Uuid
  rangeState      RangeState?
  // Set when the caregiver logged it for the member (never sent to apps).
  enteredById     String?         @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, type, recordedAt])
  @@map("health_records")
}

// Round 15: the 8 conditions (owner-edited; `code` picks the app's page).
model Condition {
  id         Int             @id @default(autoincrement())
  code       String          @unique
  nameEn     String
  nameBn     String
  subtitleEn String?
  subtitleBn String?
  sortOrder  Int             @default(0)
  users      UserCondition[]

  @@map("conditions")
}

model UserCondition {
  userId      String   @db.Uuid
  conditionId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Restrict)

  @@id([userId, conditionId])
  @@map("user_conditions")
}

// Round 15: the doctor's numbers, entered by the user or their caregiver.
// Every field NULL = not set (no range chip, no alert for that kind).
// Sugar is stored in mmol/L whatever the display unit.
model HealthLimits {
  userId            String    @id @db.Uuid
  sugarUnit         SugarUnit @default(MMOL)
  fastingLow        Float?
  fastingHigh       Float?
  afterFoodHigh     Float?
  lowSugar          Float?
  hba1cTarget       Float?
  bpSystolicHigh    Int?
  bpDiastolicHigh   Int?
  bpSystolicLow     Int?
  // Crisis sheet level; NULL = the fixed 180/120 (160/110 in pregnancy).
  bpCrisisSystolic  Int?
  bpCrisisDiastolic Int?
  peakFlowBest      Int?
  weightGain3Days   Float?
  tshLow            Float?
  tshHigh           Float?
  fluidLimitMl      Int?
  feverAboveF       Float?
  weightGoalKg      Float?
  waterGlasses      Int?
  sleepHours        Float?
  // "Tell my family when a reading is out of range" (the caregiver only).
  notifyFamily      Boolean   @default(true)
  // Which doctor gave the numbers, and when (free text).
  doctorNote        String?
  updatedById       String?   @db.Uuid
  updatedAt         DateTime  @updatedAt

  user User @relation("HealthLimitsOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_limits")
}

// Round 15: per-condition settings and the care plan (habits, regular tests
// and how often), kept as one JSON document per (user, condition); the API
// validates its shape per condition code.
model CareSetting {
  userId        String   @db.Uuid
  conditionCode String
  data          Json
  updatedById   String?  @db.Uuid
  updatedAt     DateTime @updatedAt

  user User @relation("CareSettingOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, conditionCode])
  @@map("care_settings")
}

// Round 15: a yes for one day: a habit done ("habit:<key>"), or a night
// woken by asthma ("asthma_night"). No row = not ticked.
model DayTick {
  userId    String   @db.Uuid
  key       String
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key, day])
  @@map("day_ticks")
}

// Round 15: symptom check-ins, baby kick counts, reliever puffs, Td doses.
// `data` holds the kind's fields (symptom codes, count and minutes, ...).
model CareLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  kind          CareLogKind
  conditionCode String?
  loggedAt      DateTime    @default(now())
  data          Json
  clientId      String?     @db.Uuid
  enteredById   String?     @db.Uuid
  createdAt     DateTime    @default(now())

  user User @relation("CareLogOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, kind, loggedAt])
  @@map("care_logs")
}

// Round 15: "Questions for my doctor".
model DoctorQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  text        String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("doctor_questions")
}

model HealthSuggestionRule {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  conditionType   String
  conditionValue  String
  suggestedAction String
  enabled         Boolean  @default(true)
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User?            @relation("RuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reminders HealthReminder[]

  @@index([enabled])
  @@map("health_suggestion_rules")
}

// AI-generated, per-user health suggestions -- distinct from
// `HealthSuggestionRule` (admin-authored, deterministic rules). Each row
// is one AI generation run for one user, covering their current
// verified medicines at generation time. `items*` is a JSON array of
// {category, text} objects; the shape is intentionally open-ended (not
// a fixed food/test schema) so any relevant suggestion category can be
// generated. Never shown to the user until an admin reviews and
// publishes it.
model HealthSuggestion {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  // The routine this suggestion was requested for (admin-initiated, one
  // medicine). Null only for older, per-user auto-generated rows.
  routineId       String?          @db.Uuid
  itemsEn         Json
  itemsBn         Json
  // Snapshot of the medicine names sent to the model for this
  // generation, kept for admin context/audit -- not re-derived later.
  sourceMedicines String
  status          SuggestionStatus @default(DRAFT)
  publishedById   String?          @db.Uuid
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User             @relation("SuggestionSubject", fields: [userId], references: [id], onDelete: Cascade)
  publishedBy User?            @relation("SuggestionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  routine     MedicineRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([routineId, createdAt])
  @@map("health_suggestions")
}

model Notice {
  id           String         @id @default(uuid()) @db.Uuid
  title        String
  content      String
  status       NoticeStatus   @default(DRAFT)
  audience     NoticeAudience @default(ALL)
  publishedAt  DateTime?
  expiresAt    DateTime?
  // Where the information comes from, shown with the notice (e.g. "DGHS").
  source       String?
  sourceUrl    String?
  // Scheduled publishing: not shown before this time.
  startsAt     DateTime?
  approvedById String?        @db.Uuid
  approvedAt   DateTime?
  // An admin's note when sending a pharmacist's notice back to draft.
  reviewNote   String?
  createdById  String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy  User?            @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?            @relation("NoticeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  // No rows = every division.
  divisions  NoticeDivision[]

  @@index([status, publishedAt])
  @@map("notices")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            NotificationType
  title           String
  body            String
  // Id of the thing this notification is about (dose, prescription, notice,
  // invitation). Together with (userId, type) it is the idempotency key:
  // the same event can never produce two rows for the same recipient.
  relatedEntityId String?
  // Minimal, non-sensitive routing data for deep links (e.g. the family
  // member's user id). Never medicine names or doses.
  data            Json?
  isRead          Boolean          @default(false)
  readAt          DateTime?
  pushStatus      PushStatus       @default(PENDING)
  pushAttempts    Int              @default(0)
  pushedAt        DateTime?
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, relatedEntityId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([pushStatus, createdAt])
  @@map("notifications")
}

// One row per app install. The raw FCM token is only ever stored encrypted
// (AES-256-GCM); `tokenHash` (SHA-256) is what we look up / de-duplicate by.
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  tokenHash  String         @unique
  tokenEnc   String
  platform   DevicePlatform
  appVersion String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// One AI-assistant chat. Owned by exactly one user; deleting the user or the
// conversation cascades to its messages. After the 10th user message has been
// answered the status becomes CLOSED and the conversation is read-only.
// `userMessageCount` is only ever changed while holding this row's lock (see
// AssistantService), and a CHECK constraint in the migration keeps it 0..10.
model AssistantConversation {
  id               String                      @id @default(uuid()) @db.Uuid
  userId           String                      @db.Uuid
  status           AssistantConversationStatus @default(OPEN)
  userMessageCount Int                         @default(0)
  closedAt         DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

// One row per user message and per assistant reply. `seq` is the position in
// the conversation (1, 2, 3, ...): user messages are odd, replies even. The
// unique (conversationId, seq) both orders messages and makes a duplicate
// reply impossible; (conversationId, clientMessageId) makes a retried send
// idempotent (the key is set on user messages only).
model AssistantMessage {
  id              String               @id @default(uuid()) @db.Uuid
  conversationId  String               @db.Uuid
  seq             Int
  role            AssistantMessageRole
  content         String
  // Assistant rows only: ANSWER | EMERGENCY | REFUSAL, and the language the
  // reply was written in (selects the server-side disclaimer on reload).
  kind            String?
  language        Language?
  // User rows only: client-generated idempotency key.
  clientMessageId String?              @db.Uuid
  createdAt       DateTime             @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@unique([conversationId, clientMessageId])
  @@map("assistant_messages")
}

// One-time code (SMS) for the forgot-password flow. At most one live code per
// user (re-requesting replaces it). Only an HMAC of the code is stored; it
// expires quickly and locks after a few wrong guesses.
model PasswordResetCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

// ---------------------------------------------------------------------------
// Lookup tables (Round 4). Every dropdown reads one of these; the owner adds
// or edits rows directly in the database. English only.
// ---------------------------------------------------------------------------

model Gender {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("genders")
}

model Division {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  districts District[]
  users     User[]
  notices   NoticeDivision[]

  @@map("divisions")
}

model District {
  id         Int       @id @default(autoincrement())
  divisionId Int
  name       String
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas   Upazila[]
  users      User[]
  doctors    Doctor[]

  @@unique([divisionId, name])
  // Target of composite foreign keys that keep a district inside its division.
  @@unique([id, divisionId])
  @@map("districts")
}

model Upazila {
  id         Int      @id @default(autoincrement())
  districtId Int
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  users      User[]

  @@unique([districtId, name])
  // Target of composite foreign keys that keep an upazila inside its district.
  @@unique([id, districtId])
  @@map("upazilas")
}

/// The doctor "genre" list.
model DoctorSpecialty {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  doctors Doctor[]

  @@map("doctor_specialties")
}

/// Tablet, Capsule, Syrup...
model MedicineForm {
  id                Int                    @id @default(autoincrement())
  name              String                 @unique
  medicines         Medicine[]
  prescriptionLines PrescriptionMedicine[]
  routines          MedicineRoutine[]

  @@map("medicine_forms")
}

/// The medicine "genre" list (therapeutic category).
model MedicineCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  medicines Medicine[]

  @@map("medicine_categories")
}

model MealTiming {
  id                Int                    @id @default(autoincrement())
  name              String                 @unique
  prescriptionLines PrescriptionMedicine[]
  routines          MedicineRoutine[]
  prescriptionTests PrescriptionTest[]
  healthReminders   HealthReminder[]

  @@map("meal_timings")
}

model TestCategory {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  tests DiagnosticTest[]

  @@map("test_categories")
}

// ---------------------------------------------------------------------------
// Reference data completed by pharmacists (admin is read-only)
// ---------------------------------------------------------------------------

/// A record missing specialty, chamber or district counts as incomplete.
model Doctor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  // BMDC registration number; unique when known (duplicate check).
  bmdcNumber  String?  @unique
  specialtyId Int?
  chamber     String?
  phone       String?
  districtId  Int?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specialty     DoctorSpecialty? @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  district      District?        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdBy     User?            @relation("DoctorCreator", fields: [createdById], references: [id], onDelete: SetNull)
  prescriptions Prescription[]
  appointments        Appointment[]
  recordPrescriptions RecordPrescription[]

  @@index([name])
  @@map("doctors")
}

/// Generic (active ingredient) names, e.g. Paracetamol. Pharmacists pick one
/// or type a new one (matched case-insensitively: pending SQL 007 adds a
/// unique index on lower(name)); the owner fixes spellings in the database.
model MedicineGeneric {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  medicines Medicine[]

  @@map("medicine_generics")
}

/// Strength is not stored here: it lives on the prescription/routine line.
model Medicine {
  id           String   @id @default(uuid()) @db.Uuid
  brandName    String
  genericId    Int?
  formId       Int?
  categoryId   Int?
  manufacturer String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  generic   MedicineGeneric?       @relation(fields: [genericId], references: [id], onDelete: Restrict)
  form      MedicineForm?          @relation(fields: [formId], references: [id], onDelete: Restrict)
  category  MedicineCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User?                  @relation("MedicineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     PrescriptionMedicine[]

  @@unique([brandName, formId])
  @@index([genericId])
  @@map("medicines")
}

model DiagnosticTest {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  categoryId Int?
  createdAt  DateTime @default(now())

  category      TestCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prescriptions PrescriptionTest[]
  reminders     HealthReminder[]
  testKinds     TestKind[]

  @@map("diagnostic_tests")
}

model PrescriptionTest {
  prescriptionId String    @db.Uuid
  testId         String    @db.Uuid
  // Optional test date; without one the reminder is 3 days after confirmation.
  scheduledDate  DateTime? @db.Date
  // "HH:mm" reminder time; null = 08:00.
  time           String?
  mealTimingId   Int?
  note           String?

  prescription Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  test         DiagnosticTest @relation(fields: [testId], references: [id], onDelete: Restrict)
  mealTiming   MealTiming?    @relation(fields: [mealTimingId], references: [id], onDelete: Restrict)

  @@id([prescriptionId, testId])
  @@map("prescription_tests")
}

model NoticeDivision {
  noticeId   String @db.Uuid
  divisionId Int

  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  @@id([noticeId, divisionId])
  @@index([divisionId])
  @@map("notice_divisions")
}

/// Who changed what for whom: caregiver actions on a member's routines, and
/// pharmacist/admin prescription actions. Append-only, kept indefinitely.
/// Never put passwords, tokens or phone numbers in before/after.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  subjectUserId String?  @db.Uuid
  // e.g. "routine.update", "prescription.reject"
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  actor       User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectUser User? @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt])
  @@index([actorId, createdAt])
  // Admin audit log: newest first, keyset pages.
  @@index([createdAt, id])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Round 16: health records 2.0
// ---------------------------------------------------------------------------

// A doctor the patient typed (private to them, reused next time); patients
// never touch the pharmacists' catalog (doctors).
model MyDoctor {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  chamber   String?
  area      String?
  createdAt DateTime @default(now())

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  recordPrescriptions RecordPrescription[]

  @@index([userId])
  @@map("my_doctors")
}

// Doctor visits, pregnancy check-ups and chemo sessions. At most one of
// doctorId (catalog) / myDoctorId (private) is set.
model Appointment {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  kind          AppointmentKind @default(VISIT)
  date          DateTime        @db.Date
  // "HH:mm", optional.
  time          String?
  doctorId      String?         @db.Uuid
  myDoctorId    String?         @db.Uuid
  conditionCode String?
  // ANC check-up number (1, 2, ...).
  number        Int?
  note          String?
  remind        Boolean         @default(true)
  doneAt        DateTime?
  createdById   String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user     User      @relation("AppointmentOwner", fields: [userId], references: [id], onDelete: Cascade)
  doctor   Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  myDoctor MyDoctor? @relation(fields: [myDoctorId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("appointments")
}

// The tests a patient records (owner-edited lookup, EN/BN). A kind may link
// to a catalog test so a prescription's test reminder opens its result form.
model TestKind {
  id               Int     @id @default(autoincrement())
  code             String  @unique
  nameEn           String
  nameBn           String
  diagnosticTestId String? @db.Uuid
  sortOrder        Int     @default(0)

  diagnosticTest DiagnosticTest? @relation(fields: [diagnosticTestId], references: [id], onDelete: SetNull)
  fields         TestKindField[]
  ownTests       OwnTest[]

  @@map("test_kinds")
}

model TestKindField {
  id         Int     @id @default(autoincrement())
  testKindId Int
  code       String
  nameEn     String
  nameBn     String
  unit       String?
  sortOrder  Int     @default(0)

  testKind TestKind          @relation(fields: [testKindId], references: [id], onDelete: Cascade)
  values   TestResultValue[]

  @@unique([testKindId, code])
  @@map("test_kind_fields")
}

// A test the patient has coming up or has done (with results). testKindId
// NULL = "Other" (otherName typed).
model OwnTest {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  testKindId       Int?
  otherName        String?
  status           OwnTestStatus @default(UPCOMING)
  date             DateTime      @db.Date
  // Upcoming: reminder the day before at 09:00, and whether to fast.
  remind           Boolean       @default(true)
  fasting          Boolean       @default(false)
  findings         String?
  lab              String?
  conditionCode    String?
  // The prescription test reminder this result answers, if any.
  healthReminderId String?       @db.Uuid
  createdById      String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user     User              @relation("OwnTestOwner", fields: [userId], references: [id], onDelete: Cascade)
  testKind TestKind?         @relation(fields: [testKindId], references: [id], onDelete: Restrict)
  values   TestResultValue[]
  photos   RecordPhoto[]

  @@index([userId, status, date])
  @@map("own_tests")
}

// One number (or text, e.g. a blood group) on a test result. fieldId NULL =
// a value the user added by name.
model TestResultValue {
  id        String  @id @default(uuid()) @db.Uuid
  ownTestId String  @db.Uuid
  fieldId   Int?
  name      String
  value     Float?
  textValue String?
  unit      String?
  sortOrder Int     @default(0)

  ownTest OwnTest        @relation(fields: [ownTestId], references: [id], onDelete: Cascade)
  field   TestKindField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([ownTestId])
  @@map("test_result_values")
}

// A prescription kept for the record only: never in the pharmacist queue,
// creates no medicines.
model RecordPrescription {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  date          DateTime @db.Date
  doctorId      String?  @db.Uuid
  myDoctorId    String?  @db.Uuid
  conditionCode String?
  note          String?
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User          @relation("RecordPrescriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  doctor   Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  myDoctor MyDoctor?     @relation(fields: [myDoctorId], references: [id], onDelete: SetNull)
  photos   RecordPhoto[]

  @@index([userId, date])
  @@map("record_prescriptions")
}

// A page photo of a test report or a record-only prescription (private
// Cloudinary asset; responses carry a signed link). Exactly one owner.
model RecordPhoto {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  ownTestId            String?  @db.Uuid
  recordPrescriptionId String?  @db.Uuid
  imageUrl             String
  page                 Int      @default(1)
  createdAt            DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownTest            OwnTest?            @relation(fields: [ownTestId], references: [id], onDelete: Cascade)
  recordPrescription RecordPrescription? @relation(fields: [recordPrescriptionId], references: [id], onDelete: Cascade)

  @@index([ownTestId])
  @@index([recordPrescriptionId])
  @@map("record_photos")
}
