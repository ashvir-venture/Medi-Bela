generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  PHARMACIST
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Language {
  EN
  BN
}

// CAREGIVER (was OWNER until Round 6) runs the family: invites members and
// may act for any member who doesn't hide from family.
enum FamilyRole {
  CAREGIVER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// PENDING (uploaded) -> REJECTED (with feedback; the user may re-upload)
//                   -> AWAITING_CONFIRMATION (pharmacist prepared it)
//                   -> ACTIVE (confirmed; reminders run) -> ENDED (course over)
enum PrescriptionStatus {
  PENDING
  REJECTED
  AWAITING_CONFIRMATION
  ACTIVE
  ENDED
}

enum RoutineSource {
  PRESCRIPTION
  SELF_ADDED
}

enum DoseStatus {
  PENDING
  TAKEN
  MISSED
  SKIPPED
}

enum HealthReminderStatus {
  PENDING
  COMPLETED
  DISMISSED
}

enum HealthRecordType {
  BLOOD_PRESSURE
  BLOOD_SUGAR
  WEIGHT
  TEMPERATURE
  HEART_RATE
  OTHER
}

enum SuggestionStatus {
  DRAFT
  PUBLISHED
}

enum NoticeStatus {
  DRAFT
  // Drafted by a pharmacist, waiting for an admin.
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum NoticeAudience {
  ALL
  USER
  ADMIN
}

enum NotificationType {
  MEDICINE_REMINDER
  MISSED_DOSE_FAMILY_ALERT
  PRESCRIPTION_UPDATE
  NOTICE
  SYSTEM
}

enum PushStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum AssistantConversationStatus {
  OPEN
  CLOSED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model User {
  id                       String        @id @default(uuid()) @db.Uuid
  phone                    String        @unique
  name                     String
  address                  String?
  passwordHash             String
  role                     Role          @default(USER)
  accountStatus            AccountStatus @default(ACTIVE)
  languagePreference       Language      @default(EN)
  notificationsEnabled     Boolean       @default(true)
  // Off: no medicine reminders, backstop pushes or missed-dose family alerts.
  medicineRemindersEnabled Boolean       @default(true)
  // Off: notices are not pushed (still listed in the app).
  noticesEnabled           Boolean       @default(true)
  // The privacy flag, stored inverted: false = "Hide from family" switched
  // on, which hides this user from every family member, the owner included.
  profileVisibleToFamily   Boolean       @default(true)
  dateOfBirth              DateTime?     @db.Date
  genderId                 Int?
  // Address: each level must belong to the one above it, enforced by the
  // composite foreign keys below (a district of another division is rejected).
  divisionId               Int?
  districtId               Int?
  upazilaId                Int?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  // Set when the password is RESET (forgot-password): access tokens issued
  // before this moment are rejected, so a stolen session cannot outlive a reset.
  passwordChangedAt        DateTime?

  familyMemberships      FamilyMember[]
  sentInvitations        FamilyInvitation[]      @relation("InvitationSender")
  prescriptions          Prescription[]          @relation("PrescriptionOwner")
  reviewedPrescriptions  Prescription[]          @relation("PrescriptionReviewer")
  verifiedMedicines      PrescriptionMedicine[]  @relation("MedicineVerifier")
  medicineRoutines       MedicineRoutine[]
  medicineDoses          MedicineDose[]
  healthReminders        HealthReminder[]
  healthRecords          HealthRecord[]
  createdSuggestionRules HealthSuggestionRule[]  @relation("RuleCreator")
  healthSuggestions      HealthSuggestion[]      @relation("SuggestionSubject")
  publishedSuggestions   HealthSuggestion[]      @relation("SuggestionPublisher")
  createdNotices         Notice[]                @relation("NoticeCreator")
  notifications          Notification[]
  deviceTokens           DeviceToken[]
  assistantConversations AssistantConversation[]
  passwordResetCode      PasswordResetCode?
  gender                 Gender?                 @relation(fields: [genderId], references: [id], onDelete: Restrict)
  division               Division?               @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  district               District?               @relation(fields: [districtId, divisionId], references: [id, divisionId], onDelete: Restrict)
  upazila                Upazila?                @relation(fields: [upazilaId, districtId], references: [id, districtId], onDelete: Restrict)
  createdDoctors         Doctor[]                @relation("DoctorCreator")
  createdMedicines       Medicine[]              @relation("MedicineCreator")
  editedRoutines         MedicineRoutine[]       @relation("RoutineEditor")
  approvedNotices        Notice[]                @relation("NoticeApprover")
  auditActions           AuditLog[]              @relation("AuditActor")
  auditSubjectOf         AuditLog[]              @relation("AuditSubject")
  uploadedPrescriptions  Prescription[]          @relation("PrescriptionUploader")
  confirmedPrescriptions Prescription[]          @relation("PrescriptionConfirmer")
  createdRoutines        MedicineRoutine[]       @relation("RoutineCreator")

  @@index([role])
  @@map("users")
}

model Family {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     FamilyMember[]
  invitations FamilyInvitation[]

  @@map("families")
}

model FamilyMember {
  id       String     @id @default(uuid()) @db.Uuid
  familyId String     @db.Uuid
  userId   String     @db.Uuid
  role     FamilyRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  // A user belongs to at most ONE family. Enforced here (not just in
  // service code) so concurrent create/accept requests cannot race past it.
  @@unique([userId])
  @@map("family_members")
}

model FamilyInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  familyId     String           @db.Uuid
  invitedPhone String
  invitedById  String           @db.Uuid
  status       InvitationStatus @default(PENDING)
  respondedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([invitedPhone])
  @@index([familyId, status])
  @@map("family_invitations")
}

model Prescription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  imageUrl               String
  status                 PrescriptionStatus @default(PENDING)
  reviewedById           String?            @db.Uuid
  reviewedAt             DateTime?
  rejectionReason        String?
  processingNote         String?
  // Client-generated id sent by the mobile app on upload (see
  // PrescriptionApi.uploadDraft's `clientId`). Used purely as an
  // idempotency key so a retried offline sync can't create a duplicate
  // prescription server-side; never exposed as the canonical id.
  clientUploadId         String?            @unique
  // Filled in by the pharmacist.
  doctorId               String?            @db.Uuid
  visitDate              DateTime?          @db.Date
  diagnosis              String?
  nextVisitDate          DateTime?          @db.Date
  // A re-upload after a rejection points at the rejected prescription.
  previousPrescriptionId String?            @db.Uuid
  // Medicine lines belong to a revision. A pharmacist edit after activation
  // is a new pendingRevision; the current one keeps running until the user
  // confirms (or edits) it.
  currentRevision        Int                @default(1)
  pendingRevision        Int?
  // Who uploaded / confirmed it: the patient, or their caregiver acting for them.
  uploadedById           String?            @db.Uuid
  confirmedById          String?            @db.Uuid
  confirmedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user        User                   @relation("PrescriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?                  @relation("PrescriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploadedBy  User?                  @relation("PrescriptionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  confirmedBy User?                  @relation("PrescriptionConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  doctor      Doctor?                @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  previous    Prescription?          @relation("Reupload", fields: [previousPrescriptionId], references: [id], onDelete: SetNull)
  reuploads   Prescription[]         @relation("Reupload")
  medicines   PrescriptionMedicine[]
  tests       PrescriptionTest[]

  @@index([userId, status])
  // Admin queues: filter by status, newest first, cursor-paginated.
  @@index([status, createdAt])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionMedicine {
  id             String    @id @default(uuid()) @db.Uuid
  prescriptionId String    @db.Uuid
  medicineName   String
  dosage         String
  // Human-readable frequency as written by the admin/pharmacist (e.g.
  // "twice daily"). Kept alongside the structured fields below because
  // it's what gets displayed to the user; the structured fields are what
  // routine generation actually consumes.
  frequency      String
  duration       String
  instructions   String?
  // --- Structured fields consumed by deterministic routine generation ---
  // Number of doses per day. Required (and validated) before a
  // prescription can be completed — never inferred from `frequency`.
  timesPerDay    Int?
  // Explicit clock times ("HH:mm", 24h) for each dose, stored as a JSON
  // array string, e.g. ["08:00","20:00"]. Length must equal `timesPerDay`.
  scheduleTimes  String?
  // Whole-number treatment length in days, entered explicitly by the
  // admin — never parsed/guessed from the free-text `duration` field.
  durationDays   Int?
  // Optional explicit start date for the routine; if omitted, routine
  // generation defaults it to the date the prescription is completed
  // (an administrative default, not a clinical one).
  startDate      DateTime?
  // --- Structured line (Round 4) ---
  revision       Int       @default(1)
  medicineId     String?   @db.Uuid
  // Strength lives on the line, not on Medicine (e.g. "500 mg").
  strength       String?
  // Amount per dose, e.g. "1 tablet", "2 tsp".
  doseAmount     String?
  mealTimingId   Int?
  // No end date: doses keep being generated (rolling) until stopped.
  continuous     Boolean   @default(false)
  verified       Boolean   @default(false)
  verifiedById   String?   @db.Uuid
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  prescription Prescription      @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  verifiedBy   User?             @relation("MedicineVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  medicine     Medicine?         @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  mealTiming   MealTiming?       @relation(fields: [mealTimingId], references: [id], onDelete: Restrict)
  routines     MedicineRoutine[]

  @@index([prescriptionId, revision])
  @@index([medicineId])
  @@map("prescription_medicines")
}

model MedicineRoutine {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @db.Uuid
  prescriptionMedicineId String?       @db.Uuid
  medicineName           String
  dosage                 String
  frequency              String
  startDate              DateTime
  endDate                DateTime?
  active                 Boolean       @default(true)
  source                 RoutineSource @default(PRESCRIPTION)
  strength               String?
  doseAmount             String?
  mealTimingId           Int?
  // "HH:mm" JSON array, e.g. ["08:00","20:00"]. Set => the rolling job keeps
  // doses generated ahead (up to endDate, or with no end when endDate is
  // null). Null on routines created before Round 4: all their doses exist.
  scheduleTimes          String?
  // Doses exist up to (excluding) this instant; the rolling job continues here.
  generatedUntil         DateTime?
  // Set when someone other than the pharmacist changed it ("edited by you").
  lastEditedById         String?       @db.Uuid
  lastEditedAt           DateTime?
  // Who added it: the patient or their caregiver (null = from a prescription).
  createdById            String?       @db.Uuid
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptionMedicine PrescriptionMedicine? @relation(fields: [prescriptionMedicineId], references: [id], onDelete: SetNull)
  mealTiming           MealTiming?           @relation(fields: [mealTimingId], references: [id], onDelete: Restrict)
  lastEditedBy         User?                 @relation("RoutineEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  createdBy            User?                 @relation("RoutineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  doses                MedicineDose[]
  healthSuggestions    HealthSuggestion[]

  @@index([userId, active])
  @@map("medicine_routines")
}

model MedicineDose {
  id                     String     @id @default(uuid()) @db.Uuid
  routineId              String     @db.Uuid
  userId                 String     @db.Uuid
  scheduledAt            DateTime
  status                 DoseStatus @default(PENDING)
  takenAt                DateTime?
  // Set exactly once, atomically, when the missed-dose pipeline has handled
  // this dose (alert created, or deliberately skipped). Guarantees one
  // family alert per missed dose even with overlapping job runs.
  familyAlertProcessedAt DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  routine MedicineRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([routineId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("medicine_doses")
}

model HealthReminder {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  sourceRuleId String?              @db.Uuid
  title        String
  description  String?
  scheduledAt  DateTime
  status       HealthReminderStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRule HealthSuggestionRule? @relation(fields: [sourceRuleId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledAt])
  @@index([userId, status])
  @@map("health_reminders")
}

model HealthRecord {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       HealthRecordType
  value      String
  unit       String?
  notes      String?
  recordedAt DateTime         @default(now())
  // Client-generated id of the offline draft; idempotency key so a retried
  // sync (response lost, app killed) can never create the record twice.
  clientId   String?          @db.Uuid
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, type, recordedAt])
  @@map("health_records")
}

model HealthSuggestionRule {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  conditionType   String
  conditionValue  String
  suggestedAction String
  enabled         Boolean  @default(true)
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User?            @relation("RuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reminders HealthReminder[]

  @@index([enabled])
  @@map("health_suggestion_rules")
}

// AI-generated, per-user health suggestions -- distinct from
// `HealthSuggestionRule` (admin-authored, deterministic rules). Each row
// is one AI generation run for one user, covering their current
// verified medicines at generation time. `items*` is a JSON array of
// {category, text} objects; the shape is intentionally open-ended (not
// a fixed food/test schema) so any relevant suggestion category can be
// generated. Never shown to the user until an admin reviews and
// publishes it.
model HealthSuggestion {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  // The routine this suggestion was requested for (admin-initiated, one
  // medicine). Null only for older, per-user auto-generated rows.
  routineId       String?          @db.Uuid
  itemsEn         Json
  itemsBn         Json
  // Snapshot of the medicine names sent to the model for this
  // generation, kept for admin context/audit -- not re-derived later.
  sourceMedicines String
  status          SuggestionStatus @default(DRAFT)
  publishedById   String?          @db.Uuid
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User             @relation("SuggestionSubject", fields: [userId], references: [id], onDelete: Cascade)
  publishedBy User?            @relation("SuggestionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  routine     MedicineRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([routineId, createdAt])
  @@map("health_suggestions")
}

model Notice {
  id           String         @id @default(uuid()) @db.Uuid
  title        String
  content      String
  status       NoticeStatus   @default(DRAFT)
  audience     NoticeAudience @default(ALL)
  publishedAt  DateTime?
  expiresAt    DateTime?
  // Where the information comes from, shown with the notice (e.g. "DGHS").
  source       String?
  sourceUrl    String?
  // Scheduled publishing: not shown before this time.
  startsAt     DateTime?
  approvedById String?        @db.Uuid
  approvedAt   DateTime?
  // An admin's note when sending a pharmacist's notice back to draft.
  reviewNote   String?
  createdById  String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy  User?            @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?            @relation("NoticeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  // No rows = every division.
  divisions  NoticeDivision[]

  @@index([status, publishedAt])
  @@map("notices")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            NotificationType
  title           String
  body            String
  // Id of the thing this notification is about (dose, prescription, notice,
  // invitation). Together with (userId, type) it is the idempotency key:
  // the same event can never produce two rows for the same recipient.
  relatedEntityId String?
  // Minimal, non-sensitive routing data for deep links (e.g. the family
  // member's user id). Never medicine names or doses.
  data            Json?
  isRead          Boolean          @default(false)
  readAt          DateTime?
  pushStatus      PushStatus       @default(PENDING)
  pushAttempts    Int              @default(0)
  pushedAt        DateTime?
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, relatedEntityId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([pushStatus, createdAt])
  @@map("notifications")
}

// One row per app install. The raw FCM token is only ever stored encrypted
// (AES-256-GCM); `tokenHash` (SHA-256) is what we look up / de-duplicate by.
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  tokenHash  String         @unique
  tokenEnc   String
  platform   DevicePlatform
  appVersion String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// One AI-assistant chat. Owned by exactly one user; deleting the user or the
// conversation cascades to its messages. After the 10th user message has been
// answered the status becomes CLOSED and the conversation is read-only.
// `userMessageCount` is only ever changed while holding this row's lock (see
// AssistantService), and a CHECK constraint in the migration keeps it 0..10.
model AssistantConversation {
  id               String                      @id @default(uuid()) @db.Uuid
  userId           String                      @db.Uuid
  status           AssistantConversationStatus @default(OPEN)
  userMessageCount Int                         @default(0)
  closedAt         DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

// One row per user message and per assistant reply. `seq` is the position in
// the conversation (1, 2, 3, ...): user messages are odd, replies even. The
// unique (conversationId, seq) both orders messages and makes a duplicate
// reply impossible; (conversationId, clientMessageId) makes a retried send
// idempotent (the key is set on user messages only).
model AssistantMessage {
  id              String               @id @default(uuid()) @db.Uuid
  conversationId  String               @db.Uuid
  seq             Int
  role            AssistantMessageRole
  content         String
  // Assistant rows only: ANSWER | EMERGENCY | REFUSAL, and the language the
  // reply was written in (selects the server-side disclaimer on reload).
  kind            String?
  language        Language?
  // User rows only: client-generated idempotency key.
  clientMessageId String?              @db.Uuid
  createdAt       DateTime             @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@unique([conversationId, clientMessageId])
  @@map("assistant_messages")
}

// One-time code (SMS) for the forgot-password flow. At most one live code per
// user (re-requesting replaces it). Only an HMAC of the code is stored; it
// expires quickly and locks after a few wrong guesses.
model PasswordResetCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

// ---------------------------------------------------------------------------
// Lookup tables (Round 4). Every dropdown reads one of these; the owner adds
// or edits rows directly in the database. English only.
// ---------------------------------------------------------------------------

model Gender {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("genders")
}

model Division {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  districts District[]
  users     User[]
  notices   NoticeDivision[]

  @@map("divisions")
}

model District {
  id         Int       @id @default(autoincrement())
  divisionId Int
  name       String
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas   Upazila[]
  users      User[]
  doctors    Doctor[]

  @@unique([divisionId, name])
  // Target of composite foreign keys that keep a district inside its division.
  @@unique([id, divisionId])
  @@map("districts")
}

model Upazila {
  id         Int      @id @default(autoincrement())
  districtId Int
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  users      User[]

  @@unique([districtId, name])
  // Target of composite foreign keys that keep an upazila inside its district.
  @@unique([id, districtId])
  @@map("upazilas")
}

/// The doctor "genre" list.
model DoctorSpecialty {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  doctors Doctor[]

  @@map("doctor_specialties")
}

/// Tablet, Capsule, Syrup...
model MedicineForm {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  medicines Medicine[]

  @@map("medicine_forms")
}

/// The medicine "genre" list (therapeutic category).
model MedicineCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  medicines Medicine[]

  @@map("medicine_categories")
}

model MealTiming {
  id                Int                    @id @default(autoincrement())
  name              String                 @unique
  prescriptionLines PrescriptionMedicine[]
  routines          MedicineRoutine[]

  @@map("meal_timings")
}

model TestCategory {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  tests DiagnosticTest[]

  @@map("test_categories")
}

// ---------------------------------------------------------------------------
// Reference data completed by pharmacists (admin is read-only)
// ---------------------------------------------------------------------------

/// A record missing specialty, chamber or district counts as incomplete.
model Doctor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  // BMDC registration number; unique when known (duplicate check).
  bmdcNumber  String?  @unique
  specialtyId Int?
  chamber     String?
  phone       String?
  districtId  Int?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specialty     DoctorSpecialty? @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  district      District?        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdBy     User?            @relation("DoctorCreator", fields: [createdById], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([name])
  @@map("doctors")
}

/// Generic (active ingredient) names, e.g. Paracetamol. Pharmacists pick one
/// or type a new one (matched case-insensitively: pending SQL 007 adds a
/// unique index on lower(name)); the owner fixes spellings in the database.
model MedicineGeneric {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  medicines Medicine[]

  @@map("medicine_generics")
}

/// Strength is not stored here: it lives on the prescription/routine line.
model Medicine {
  id           String   @id @default(uuid()) @db.Uuid
  brandName    String
  genericId    Int?
  formId       Int?
  categoryId   Int?
  manufacturer String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  generic   MedicineGeneric?       @relation(fields: [genericId], references: [id], onDelete: Restrict)
  form      MedicineForm?          @relation(fields: [formId], references: [id], onDelete: Restrict)
  category  MedicineCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User?                  @relation("MedicineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     PrescriptionMedicine[]

  @@unique([brandName, formId])
  @@index([genericId])
  @@map("medicines")
}

model DiagnosticTest {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  categoryId Int?
  createdAt  DateTime @default(now())

  category      TestCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prescriptions PrescriptionTest[]

  @@map("diagnostic_tests")
}

model PrescriptionTest {
  prescriptionId String @db.Uuid
  testId         String @db.Uuid

  prescription Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  test         DiagnosticTest @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@id([prescriptionId, testId])
  @@map("prescription_tests")
}

model NoticeDivision {
  noticeId   String @db.Uuid
  divisionId Int

  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  @@id([noticeId, divisionId])
  @@index([divisionId])
  @@map("notice_divisions")
}

/// Who changed what for whom: caregiver actions on a member's routines, and
/// pharmacist/admin prescription actions. Append-only, kept indefinitely.
/// Never put passwords, tokens or phone numbers in before/after.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  subjectUserId String?  @db.Uuid
  // e.g. "routine.update", "prescription.reject"
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  actor       User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectUser User? @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
