DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_name?schema=public"

# JWT / CORS / misc — set these as required by the rest of the app
PORT=3000
CORS_ORIGINS="http://localhost:3001"

# Cloudinary — used to store prescription images (feature 2)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# LLM — OpenAI-compatible /chat/completions endpoint, used for the
# AI-generated health suggestion feature (feature 1). Free/low-cost
# models work fine since prompts are short and JSON-only.
LLM_API_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ---- Phase 4A: notifications / family -------------------------------------
# JWT (required — the app refuses to start without them)
JWT_ACCESS_SECRET=""
# Single long-lived access token (no refresh flow in the MVP).
JWT_ACCESS_EXPIRES_IN=30d

# AES-256 key protecting stored FCM device tokens. REQUIRED. Generate with:
#   openssl rand -base64 32
# Rotating it invalidates stored tokens (apps re-register on next launch).
PUSH_TOKEN_ENC_KEY=""

# Firebase Admin credentials — set ONE. Without any, push is disabled (inbox still works).
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=""
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Timezone offset of the market the app serves (minutes from UTC). Bangladesh = 360.
APP_UTC_OFFSET_MINUTES=360
# ---- Reminder timings (common/config/reminder-timing.ts). The app reads them
# from GET /api/app-config on every refresh and reschedules, so a change here
# reaches phones within APP_SYNC_MINUTES (or at the next app open).
# Minutes between medicine rings; Later waits this long too.
REMINDER_REPEAT_MINUTES=15
# Rings per dose time (the first at the dose time).
REMINDER_RINGS=4
# How long each ring sounds.
REMINDER_RING_MINUTES=2
# Minutes after the dose time before an untaken dose is MISSED and the family is
# alerted. Must be more than (REMINDER_RINGS - 1) x REPEAT + RING_MINUTES
# (4 rings: 3 x 15 + 2 = 47), else the API logs a warning at start.
DOSE_MISSED_GRACE_MINUTES=50
# Server backstop push to the patient (defaults to REMINDER_REPEAT_MINUTES).
BACKSTOP_AFTER_MINUTES=15
# "Taken" stays possible until this long before the same medicine's next dose.
TAKEN_CLOSES_BEFORE_NEXT_MINUTES=60
# Test reminders: days they ring (the caregiver is told on the last), the delay
# when the pharmacist gave no date, and the time when none was given.
TEST_REMINDER_DAYS=3
TEST_REMINDER_DEFAULT_DELAY_DAYS=3
TEST_REMINDER_DEFAULT_TIME=08:00
# Medicine box: "running low" at this many doses left.
MEDICINE_BOX_LOW_DOSES=3
# The app pulls from the server this often while it is open and online.
APP_SYNC_MINUTES=10
# Missed doses older than this at detection time are closed without alerting family.
MISSED_ALERT_MAX_AGE_MINUTES=360
# Background jobs (set to "false" on instances that should not run them)
MISSED_DOSE_JOB_ENABLED=true
# Keeps doses generated 14 days ahead for each active routine (hourly).
ROLLING_DOSE_JOB_ENABLED=true
PUSH_DISPATCH_JOB_ENABLED=true
# Publishes scheduled notices (startsAt) every minute. Single API instance only.
NOTICE_SCHEDULE_JOB_ENABLED=true
# Test reminders: caregiver alert on day 3, MISSED a day later (every 5 minutes).
TEST_REMINDER_JOB_ENABLED=true

# ---- Deployment ---------------------------------------------------------------
# Set to the number of reverse proxies / load balancers in front of the API
# (usually 1) so the login throttle sees real client IPs. Leave unset if none.
TRUST_PROXY=

# ---- Rate limiting --------------------------------------------------------------
# One global limit per minute: per user when signed in, per client IP on public
# routes (login, register, password reset). Counters are in memory, so run a
# single API instance. Behind a proxy, also set TRUST_PROXY above or every public
# request shares one bucket. Off under Jest; set RATE_LIMIT_ENABLED=false to turn off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_IP_PER_MINUTE=60

# ---- Maintenance ----------------------------------------------------------------
# true: every route answers 503 (code MAINTENANCE) except /api/health, and the
# app and panel show "Medi-Bela is being updated". Restart the API after changing it.
MAINTENANCE_MODE=false

# ---- SMS (forgot-password codes) ------------------------------------------------
# HTTP SMS gateway: POST JSON { to, message, sender } with "Authorization: Bearer <key>".
# Adapt src/auth/sms.service.ts if your provider uses a different request format.
# Without these, production sends NO reset codes (outside production the code is logged).
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Seed (npm run prisma:seed) -------------------------------------------
# Admin account (defaults are in prisma/seed.ts; set your own outside dev).
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
# Optional pharmacist account; created only when both are set.
SEED_PHARMACIST_PHONE=
SEED_PHARMACIST_PASSWORD=
